# Private runtime values are generated from .local/infra.env by scripts/encvoy-env.mjs.
# This file documents the local-only values without containing credentials.
NODE_ENV=development
DOMAIN=http://localhost:9090
VITE_DOMAIN=http://localhost:9090
ID_HOST=localhost:9090
ID_BASE_PATH=
DATABASE_URL=postgresql://<local-user>:<local-password>@127.0.0.1:55432/encvoy
CLIENT_ID=<local-system-client-id>
ADMIN_LOGIN=<local-owner-login>
ADMIN_PASSWORD=<private-local-owner-password>
OIDC_COOKIE_SECRET=<private-random-cookie-secret>
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
ENCVOY_PORT=9090
