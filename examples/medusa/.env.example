NODE_ENV=development
HOST=127.0.0.1
PORT=9000
DATABASE_URL=postgresql://medusa:replace-with-local-password@127.0.0.1:55432/medusa
REDIS_URL=redis://127.0.0.1:56379/1
JWT_SECRET=replace-with-at-least-32-random-bytes
COOKIE_SECRET=replace-with-at-least-32-random-bytes
MEDUSA_BROWSER_ORIGIN=http://localhost:9000
ADMIN_AUTH_TYPE=jwt
MEDUSA_DISABLE_TELEMETRY=true
ENCVOY_ISSUER=http://localhost:9090
ENCVOY_ALLOW_INSECURE_LOCALHOST=true
ENCVOY_CUSTOMER_CLIENT_ID=register-a-customer-client
ENCVOY_CUSTOMER_CLIENT_SECRET=store-the-secret-only-in-the-server-env
ENCVOY_USER_CLIENT_ID=register-a-separate-employee-client
ENCVOY_USER_CLIENT_SECRET=store-the-secret-only-in-the-server-env
# Trusted server-side provisioning commands only:
# EMPLOYEE_EMAIL=employee@example.invalid
# EMPLOYEE_MEDUSA_USER_ID=user_...
# EMPLOYEE_ENCVOY_SUBJECT=subject-verified-in-encvoy
